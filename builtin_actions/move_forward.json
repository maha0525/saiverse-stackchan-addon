{
  "id": "move_forward",
  "display_name": "前進",
  "description": "車輪（CH2/CH3）を回して前に進む。duration_ms で進む時間を指定（省略時 1000ms = 1秒）。指定時間が経つと自動で停止する。狭い屋内なので短めの時間で少しずつ進むとよい。",
  "parameters": {
    "duration_ms": {
      "type": "integer",
      "default": 1000,
      "min": 100,
      "max": 3000,
      "description": "進む時間（ミリ秒。1000で1秒）"
    }
  },
  "steps": [
    {
      "type": "parallel",
      "calls": [
        {"tool": "servo8_set_speed", "args": {"channel": 2, "speed": -50}},
        {"tool": "servo8_set_speed", "args": {"channel": 3, "speed": 50}}
      ]
    },
    {"type": "wait", "duration_ms": "${duration_ms}"},
    {
      "type": "parallel",
      "calls": [
        {"tool": "servo8_set_speed", "args": {"channel": 2, "speed": 0}},
        {"tool": "servo8_set_speed", "args": {"channel": 3, "speed": 0}}
      ]
    }
  ]
}
